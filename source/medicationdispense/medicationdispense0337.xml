<?xml version="1.0" encoding="UTF-8"?>
<MedicationDispense xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://hl7.org/fhir ../../schema/medicationdispense.xsd"
    xmlns="http://hl7.org/fhir">
    <id value="meddisp0337"/>
    <!-- The authorizing prescription is contained, so that the dispense carries the number of authorized repeats
         (dispenseRequest.numberOfRepeatsAllowed), for example when it is sent in a transfer of care document.
         The number of supplies made so far against the prescription is in fillNumber. -->
    <contained>
        <MedicationRequest>
            <id value="rx"/>
            <status value="active"/>
            <intent value="order"/>
            <medication>
                <concept>
                    <text value="Pulmicort Turbuhaler 400 microgram/actuation inhalation (budesonide)"/>
                </concept>
            </medication>
            <subject>
                <reference value="Patient/pat1"/>
                <display value="Donald Duck"/>
            </subject>
            <authoredOn value="2026-03-02"/>
            <requester>
                <reference value="Practitioner/f007"/>
            </requester>
            <dosageInstruction>
                <step><component>
                    <text value="1 inhalation twice daily"/>
                </component></step>
            </dosageInstruction>
            <dispenseRequest>
                <numberOfRepeatsAllowed value="5"/>
                <quantity>
                    <value value="1"/>
                    <unit value="inhaler"/>
                    <system value="http://unitsofmeasure.org"/>
                    <code value="{inhaler}"/>
                </quantity>
            </dispenseRequest>
        </MedicationRequest>
    </contained>
    <status value="completed"/>
    <medication>
        <concept>
            <text value="Pulmicort Turbuhaler 400 microgram/actuation inhalation (budesonide)"/>
        </concept>
    </medication>
    <subject>
        <reference value="Patient/pat1"/>
        <display value="Donald Duck"/>
    </subject>
    <performer>
        <actor>
            <reference value="Practitioner/f006"/>
        </actor>
    </performer>
    <authorizingPrescription>
        <reference value="#rx"/>
    </authorizingPrescription>
    <type>
        <coding>
            <system value="http://terminology.hl7.org/CodeSystem/v3-ActCode"/>
            <code value="RF"/>
            <display value="Refill"/>
        </coding>
    </type>
    <quantity>
        <value value="1"/>
        <unit value="inhaler"/>
        <system value="http://unitsofmeasure.org"/>
        <code value="{inhaler}"/>
    </quantity>
    <daysSupply>
        <value value="30"/>
        <unit value="Day"/>
        <system value="http://unitsofmeasure.org"/>
        <code value="d"/>
    </daysSupply>
    <fillNumber value="3"/>
    <whenHandedOver value="2026-05-04T11:00:00+10:00"/>
    <note>
        <text value="Third supply against the prescription: the original supply and the 2nd of the 5 authorized repeats. 3 repeats remain."/>
    </note>
    <dosageInstruction>
        <step><component>
            <text value="1 inhalation twice daily"/>
        </component></step>
    </dosageInstruction>
</MedicationDispense>
